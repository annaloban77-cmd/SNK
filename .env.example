# NK-Контроль — пример переменных окружения
# Скопируйте в .env и заполните реальными значениями

# Database (SQLite)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# NextAuth (опционально, для будущей авторизации)
# NEXTAUTH_SECRET="your-secret-here"
# NEXTAUTH_URL="http://localhost:3000"

# Z.AI SDK (для VLM/LLM — только fallback и семантика)
# Ключ получается автоматически через z-ai-web-dev-sdk
# ZAI_API_KEY="your-zai-key"

# OCR Sidecar (PaddleOCR, опционально)
# OCR_SIDECAR_URL="http://localhost:8100"

# Local-only mode (запрещает облачные VLM)
# NK_LOCAL_ONLY=false

# File storage
UPLOADS_DIR="/home/z/my-project/uploads"

# Bench data
BENCH_SAMPLES_DIR="/home/z/my-project/public/bench/samples"
BENCH_SVG_DIR="/home/z/my-project/public/bench/svg"
BENCH_DXF_DIR="/home/z/my-project/public/bench/dxf"
BENCH_DEGRADED_DIR="/home/z/my-project/public/bench/degraded"
BENCH_EXPECTED_DIR="/home/z/my-project/public/bench/expected"

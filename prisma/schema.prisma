// НК-Контроль — Система нормативного контроля для судостроения
// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Справочник типов документов (чертеж детали, сборочный чертеж, спецификация и т.д.)
model DocType {
  id          String   @id @default(cuid())
  code        String   @unique // "drawing", "assembly", "specification", "welding", "circuit"...
  name        String   // "Чертеж детали"
  category    String   // "graphic" | "text" | "table" | "cad"
  createdAt   DateTime @default(now())
  documents   Document[]
}

// Проект / комплект документации
model Project {
  id          String   @id @default(cuid())
  code        String   @unique // "Судно-проект-2025"
  name        String
  description String?
  stage       String   @default("РК") // стадия разработки: ЭП, ТП, РД, РК
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  documents   Document[]
}

// Документ (скан или CAD-файл)
model Document {
  id            String   @id @default(cuid())
  projectId     String?
  name          String   // имя файла
  originalName  String
  mimeType      String
  size          Int      // в байтах
  format        String   // A4 | A3 | A2 | A1 | A0 | unknown
  sourceType    String   // "scan" | "pdf" | "dwg" | "dxf" | "cdw" | "sldprt" | "sldasm" | "slddrw" | "spw"
  status        String   @default("new") // new | processing | analyzed | failed
  filePath      String   // путь к сохраненному файлу (uploads/)
  // Извлечённые данные (после VLM-анализа)
  stampJson     String?  // JSON-строка с полями штампа
  ocrText       String?  // распознанный текст (если есть)
  // Метрики проверки
  issueCount    Int      @default(0)
  highCount     Int      @default(0)
  mediumCount   Int      @default(0)
  lowCount      Int      @default(0)
  checkDuration Int?     // мс
  // Связи
  docTypeId     String?
  docType       DocType? @relation(fields: [docTypeId], references: [id])
  project       Project? @relation(fields: [projectId], references: [id])
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id])
  issues        Issue[]
  checks        CheckLog[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

// Нормативный документ (ГОСТ/ОСТ/СТО/РД/Регистр)
model Standard {
  id          String   @id @default(cuid())
  code        String   @unique // "ГОСТ 2.104-2006"
  name        String   // "Основные надписи"
  type        String   // "GOST" | "OST" | "STO" | "RD" | "REGISTER" | "ESKD" | "ESTD" | "ESPD" | "SPDS"
  scope       String   // область применения (короткое описание)
  description String?  // полное описание / ключевые требования
  status      String   @default("active") // active | cancelled | draft
  publishedAt String?  // год/дата
  category    String?  // категория для группировки (eskd | estd | materials | welding | tolerances | shipbuilding | register | rd | sto | spds)
  source      String   @default("manual") // manual | cntd | rs-class | rr-reg | imported
  sourceUrl   String?  // URL оригинала (docs.cntd.ru/...)
  clauses     StandardClause[]
  rules       Rule[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([category])
}

// Ключевые пункты стандарта (для RAG/LLM-проверок)
model StandardClause {
  id          String   @id @default(cuid())
  standardId  String
  number      String   // "3.1", "4.2.1"
  title       String   // название пункта
  text        String   // текст требования
  severity    String   @default("medium") // важность пункта
  createdAt   DateTime @default(now())
  standard    Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@index([standardId])
}

// Правило нормоконтроля
model Rule {
  id          String   @id @default(cuid())
  code        String   @unique // "R-STAMP-001"
  name        String
  description String
  category    String   // "stamp" | "specification" | "material" | "cad_attr" | "format" | "geometry" | "semantic"
  method      String   // "deterministic" | "semantic" | "vision"
  severity    String   @default("medium") // high | medium | low
  gostField   String?  // проверяемое поле/признак
  expression  String?  // для deterministic: JSON с условием
  enabled     Boolean  @default(true)
  standardId  String?
  standard    Standard? @relation(fields: [standardId], references: [id])
  issues      Issue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([enabled])
}

// Замечание нормоконтролера
model Issue {
  id           String   @id @default(cuid())
  documentId   String
  ruleId       String?
  code         String   // код правила, породившего замечание
  title        String   // краткое название
  description  String   // что не так
  requirement  String?  // требование ГОСТ
  recommendation String? // рекомендация по исправлению
  gostRef      String?  // "ГОСТ 2.104-2006, п. 3.1"
  field        String?  // проверяемое поле (Масса, Обозначение...)
  severity     String   @default("medium") // high | medium | low
  status       String   @default("new") // new | confirmed | rejected | fixed
  source       String   @default("auto") // auto | expert | llm
  evidence     String?  // доказательство (значение поля/фрагмент текста)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rule         Rule?    @relation(fields: [ruleId], references: [id])
  suggestions  KnowledgeSuggestion[]

  @@index([documentId])
  @@index([severity])
  @@index([status])
}

// Журнал проверок
model CheckLog {
  id          String   @id @default(cuid())
  documentId  String
  stage       String   // "upload" | "preprocess" | "vlm_extract" | "rules_check" | "llm_semantic" | "report"
  status      String   // "started" | "success" | "failed"
  durationMs  Int?
  message     String?
  createdAt   DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ============ MONETIZATION MODELS ============

// Организация (тенант) — для multi-tenant SaaS
model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique // для URL / идентификации
  inn           String?  // ИНН для юр.лиц
  contactEmail  String?
  contactPhone  String?
  plan          String   @default("free") // free | pro | enterprise
  maxDocuments  Int      @default(50) // лимит документов в месяц
  maxChecks     Int      @default(100) // лимит проверок в месяц
  maxUsers      Int      @default(3)
  status        String   @default("active") // active | suspended | cancelled
  trialEndsAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  documents     Document[]
  benchSamples  BenchSample[]
  benchRuns     BenchRun[]
  suggestions   KnowledgeSuggestion[]
}

// Пользователь системы
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  passwordHash    String?
  role            String   @default("engineer") // admin | normocontroller | engineer | viewer
  organizationId  String?
  status          String   @default("active") // active | disabled | pending
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization? @relation(fields: [organizationId], references: [id])
  auditLogs       AuditLog[]

  @@index([organizationId])
  @@index([role])
}

// API-ключ для программного доступа (монетизация API)
model ApiKey {
  id              String   @id @default(cuid())
  organizationId  String
  name            String   // человеко-читаемое имя ключа
  keyPrefix       String   // первые 8 символов для отображения
  keyHash         String   @unique // хэш полного ключа
  scopes          String   @default("read") // read | write | admin (через запятую)
  requestsCount   Int      @default(0)
  requestsLimit   Int      @default(1000) // лимит запросов в месяц
  periodStart     DateTime @default(now()) // начало расчётного периода
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  status          String   @default("active") // active | revoked | expired
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([status])
}

// Аудит-лог действий пользователей (для безопасности и compliance)
model AuditLog {
  id              String   @id @default(cuid())
  organizationId  String?
  userId          String?
  action          String   // "document.upload" | "document.analyze" | "issue.confirm" | "rule.toggle" | "apikey.create" ...
  resourceType    String?  // "document" | "issue" | "rule" | "standard" | "apikey"
  resourceId      String?
  details         String?  // JSON-строка с деталями
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
  organization    Organization? @relation(fields: [organizationId], references: [id])
  user            User?    @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// Подписка / биллинг (для будущей интеграции с платёжными системами)
model Subscription {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  plan            String   @default("free") // free | pro | enterprise
  status          String   @default("active") // active | past_due | cancelled | trialing
  amount          Float    @default(0) // в рублях
  currency        String   @default("RUB")
  interval        String   @default("month") // month | year
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime?
  cancelAt          DateTime?
  paymentProvider   String?  // "yookassa" | "tinkoff" | "stripe" | "manual"
  externalId        String?  // ID подписки в платёжной системе
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ BENCH (СТЕНД) — главный предохранитель релиза ============

// Эталонный/контрольный документ для стенда
model BenchSample {
  id              String   @id @default(cuid())
  code            String   @unique // "S-001", "E-042"
  title           String   // описание семпла
  category        String   // тип: "correct" | "with_errors"
  documentType    String   // "drawing" | "assembly" | "specification" | "welding" | "circuit" | "cad"
  format          String   // A4 | A3 | A2 | A1 | A0
  sourceType      String   // "scan" | "pdf" | "dwg" | "dxf" | "cdw" | "sldprt" | "sldasm" | "slddrw" | "spw"
  filePath        String   // путь к файлу семпла (public/bench/samples/...)
  expectedFindings String? // JSON-строка с ожидаемыми замечаниями (для with_errors)
  expectedCount   Int      @default(0) // сколько ошибок заложено
  expectedHigh    Int      @default(0)
  expectedMedium  Int      @default(0)
  expectedLow     Int      @default(0)
  // Категории ожидаемых ошибок (для аналитики)
  expectedCategories String? // JSON: ["stamp","material","welding",...]
  description     String?
  tier             String   @default("synthetic") // synthetic | realistic | torture | real | dxf
  isActive        Boolean  @default(true)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  createdAt       DateTime @default(now())
  findings        BenchFinding[]

  @@index([category])
  @@index([tier])
  @@index([documentType])
  @@index([isActive])
  @@index([organizationId])
}

// Один прогон стенда (запуск всех активных семплов)
model BenchRun {
  id              String   @id @default(cuid())
  version         String   // версия ядра/правил (например "0.2.1")
  status          String   @default("running") // running | completed | failed | aborted
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  durationMs      Int?
  // Метрики агрегированные
  totalSamples    Int      @default(0)
  passedSamples   Int      @default(0) // семплы где Recall>=90% Precision>=85%
  failedSamples   Int      @default(0)
  // Recall/Precision по всему прогону
  recall          Float?   // 0..1, доля ожидаемых ошибок найденных
  precision       Float?   // 0..1, доля найденных соответствующих ожиданиям
  recallHigh      Float?   // Recall только по высококритичным
  coordAccuracy   Float?   // среднее отклонение в мм (меньше = лучше)
  // Статус «зелёный/жёлтый/красный»
  benchStatus     String?  // "green" | "yellow" | "red"
  // Сводка
  totalExpected   Int      @default(0)
  totalFound      Int      @default(0)
  totalMatched    Int      @default(0) // истинные срабатывания
  totalFalsePos   Int      @default(0) // ложные срабатывания
  totalFalseNeg   Int      @default(0) // пропущенные
  notes           String?
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  findings        BenchFinding[]

  @@index([status])
  @@index([startedAt])
}

// Результат проверки одного семпла в рамках прогона
model BenchFinding {
  id              String   @id @default(cuid())
  runId           String
  sampleId        String
  // Что нашла система
  foundCode       String?  // код правила
  foundTitle      String?
  foundSeverity   String?  // high | medium | low
  foundField      String?
  foundX          Float?   // координата X найденной ошибки (мм)
  foundY          Float?   // координата Y найденной ошибки (мм)
  sourceOcr       String?  // "svg" | "tesseract" | "paddle" | "vlm" | "cad"
  // Ожидаемая ошибка (если matched)
  expectedCode    String?
  expectedTitle   String?
  expectedSeverity String?
  expectedX       Float?
  expectedY       Float?
  // Соответствие
  status          String   // "matched" | "false_positive" | "false_negative"
  coordDelta      Float?   // расстояние между found и expected в мм
  createdAt       DateTime @default(now())
  run             BenchRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  sample          BenchSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([sampleId])
  @@index([status])
  @@index([sourceOcr])
}

// ============ FEEDBACK LOOP (Блок 4) ============

model KnowledgeSuggestion {
  id          String   @id @default(cuid())
  type        String   // "bench_sample" | "new_rule" | "reference_entry"
  status      String   @default("new") // new | approved | rejected
  title       String
  description String?
  payload     String?  // JSON: { code, category, expectedFindings, filePath }
  issueId     String?
  issue       Issue?   @relation(fields: [issueId], references: [id])
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([organizationId])
}

